# ============================================================
# Philosopher App — environment configuration
# Copy this file to `.env.local` and fill in the values.
# No secrets are ever hardcoded in source; everything is read here.
# ============================================================

# ---- Model provider (LLM) ----
# Which provider to use for philosopher responses: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Model id for the selected provider.
#   anthropic default: claude-opus-4-8
#   openai example:    gpt-4o
#   ollama example:    llama3.1
LLM_MODEL=claude-opus-4-8

# Anthropic (Claude) — the default and recommended provider
ANTHROPIC_API_KEY=

# OpenAI (optional alternative)
OPENAI_API_KEY=
# Override the base URL for OpenAI-compatible servers if needed
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (optional local provider)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Voice / TTS provider ----
# Which provider synthesizes philosopher speech: elevenlabs | none
# When set to `none` (or if the key is missing) the browser's built-in
# Web Speech API is used as a free fallback.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Optional: default ElevenLabs model
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional: compact MP3 format for lower transfer/decode overhead
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
